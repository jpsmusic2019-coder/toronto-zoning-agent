# Optional. Without a key the summary comes from a fixed template (no API call).
ANTHROPIC_API_KEY=
# Optional locations (defaults: ./data and ./output under the directory you run from).
# ZONING_DATA_DIR=
# ZONING_OUTPUT_DIR=
# Optional map tiles from a licensed provider (default: City of Toronto basemap).
# ZONING_TILE_URL=
# ZONING_TILE_URL_DARK=
# ZONING_TILE_ATTRIBUTION=
# ZONING_TILE_MAX_ZOOM=19
